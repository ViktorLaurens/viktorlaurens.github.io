---
/**
 * Small inline icons for contact links. GitHub comes from Simple Icons (CC0); LinkedIn was
 * removed from Simple Icons at LinkedIn's request, so its mark is drawn here; email and the
 * CV document are plain line icons.
 */
import { siGithub } from 'simple-icons';

interface Props {
  name: 'email' | 'linkedin' | 'github' | 'cv';
  size?: number;
  brand?: boolean;
}
const { name, size = 18, brand = true } = Astro.props;
const uid = `li-${Math.random().toString(36).slice(2, 8)}`;
const colour = {
  email: 'var(--accent)',
  linkedin: '#0A66C2',
  github: 'var(--fg)',
  cv: 'var(--red)',
}[name];
---
<span class="ci" style={`--ci-size:${size}px; --ci-colour:${brand ? colour : 'currentColor'}`} aria-hidden="true">
  {name === 'email' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="m4 7 8 6 8-6" />
    </svg>
  )}
  {name === 'linkedin' && (
    <svg viewBox="0 0 24 24">
      <defs>
        <mask id={uid}>
          <rect width="24" height="24" fill="#fff" />
          <rect x="6.2" y="9.6" width="2.7" height="8.4" rx=".3" fill="#000" />
          <circle cx="7.55" cy="6.9" r="1.6" fill="#000" />
          <path d="M10.9 9.6h2.6v1.25c.5-.85 1.55-1.5 2.95-1.5 2.3 0 3.25 1.45 3.25 3.8V18h-2.7v-4.4c0-1.15-.4-1.9-1.45-1.9-1.15 0-1.9.8-1.9 2V18h-2.75z" fill="#000" />
        </mask>
      </defs>
      <rect x="2" y="2" width="20" height="20" rx="3.5" fill="currentColor" mask={`url(#${uid})`} />
    </svg>
  )}
  {name === 'github' && (
    <svg viewBox="0 0 24 24"><path d={siGithub.path} fill="currentColor" /></svg>
  )}
  {name === 'cv' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5" />
      <path d="M9 13h6M9 16.5h4" />
    </svg>
  )}
</span>

<style>
  .ci { display: inline-grid; place-items: center; width: var(--ci-size); height: var(--ci-size); color: var(--ci-colour); flex: none; }
  .ci svg { width: 100%; height: 100%; display: block; }
</style>

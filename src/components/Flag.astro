---
/** Small round flags, drawn inline so they render on Windows (which has no flag emoji). */
interface Props {
  code: 'be' | 'nl' | 'gb' | 'fr' | 'de' | 'no';
  size?: number;
  label?: string;
}
const { code, size = 20, label } = Astro.props;
const uid = `fl-${code}-${Math.random().toString(36).slice(2, 7)}`;
---
<span class="flag" style={`--flag-size:${size}px`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg viewBox="0 0 60 60">
    <defs><clipPath id={uid}><circle cx="30" cy="30" r="30" /></clipPath></defs>
    <g clip-path={`url(#${uid})`}>
      {code === 'be' && (<>
        <rect width="20" height="60" fill="#000000" /><rect x="20" width="20" height="60" fill="#FDDA24" /><rect x="40" width="20" height="60" fill="#EF3340" />
      </>)}
      {code === 'nl' && (<>
        <rect width="60" height="20" fill="#AE1C28" /><rect y="20" width="60" height="20" fill="#FFFFFF" /><rect y="40" width="60" height="20" fill="#21468B" />
      </>)}
      {code === 'fr' && (<>
        <rect width="20" height="60" fill="#002654" /><rect x="20" width="20" height="60" fill="#FFFFFF" /><rect x="40" width="20" height="60" fill="#CE1126" />
      </>)}
      {code === 'de' && (<>
        <rect width="60" height="20" fill="#000000" /><rect y="20" width="60" height="20" fill="#DD0000" /><rect y="40" width="60" height="20" fill="#FFCE00" />
      </>)}
      {code === 'no' && (<>
        <rect width="60" height="60" fill="#BA0C2F" />
        <rect x="16" width="12" height="60" fill="#FFFFFF" /><rect y="24" width="60" height="12" fill="#FFFFFF" />
        <rect x="19" width="6" height="60" fill="#00205B" /><rect y="27" width="60" height="6" fill="#00205B" />
      </>)}
      {code === 'gb' && (<>
        <rect width="60" height="60" fill="#012169" />
        <path d="M0 0 60 60M60 0 0 60" stroke="#FFFFFF" stroke-width="12" />
        <path d="M0 0 60 60M60 0 0 60" stroke="#C8102E" stroke-width="5" />
        <path d="M30 0v60M0 30h60" stroke="#FFFFFF" stroke-width="18" />
        <path d="M30 0v60M0 30h60" stroke="#C8102E" stroke-width="10" />
      </>)}
    </g>
    <circle cx="30" cy="30" r="29.25" fill="none" stroke="rgba(127,127,127,.35)" stroke-width="1.5" />
  </svg>
</span>

<style>
  .flag { display: inline-block; width: var(--flag-size); height: var(--flag-size); flex: none; vertical-align: middle; }
  .flag svg { width: 100%; height: 100%; display: block; }
</style>

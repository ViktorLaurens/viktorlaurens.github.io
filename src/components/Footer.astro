---
import ContactIcon from './ContactIcon.astro';
const year = new Date().getFullYear();
const links = [
  { name: 'email', label: 'Email viktor.degroote@gmail.com', href: 'mailto:viktor.degroote@gmail.com' },
  { name: 'linkedin', label: 'LinkedIn', href: 'https://www.linkedin.com/in/viktor-laurens-de-groote/', external: true },
  { name: 'github', label: 'GitHub', href: 'https://github.com/ViktorLaurens', external: true },
  { name: 'cv', label: 'Download CV (PDF)', href: '/cv.pdf', download: 'Viktor_Laurens_De_Groote_CV.pdf' },
] as const;
---
<footer class="footer">
  <div class="container footer__in">
    <p class="footer__copy">© {year} Viktor Laurens De Groote. All rights reserved.</p>
    <ul class="footer__links" aria-label="Contact and profiles">
      {links.map((l) => (
        <li>
          <a
            class="footer__icon"
            href={l.href}
            aria-label={l.label}
            title={l.label}
            target={'external' in l ? '_blank' : undefined}
            rel={'external' in l ? 'me noopener' : undefined}
            download={'download' in l ? l.download : undefined}
          >
            <ContactIcon name={l.name} size={19} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); margin-top: var(--space-16); background: var(--bg-sunken); }
  .footer__in { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4) var(--space-8); flex-wrap: wrap; padding-block: var(--space-6); }
  .footer__copy { font-family: var(--font-mono); font-size: .8rem; color: var(--fg-faint); }
  .footer__links { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-2); }
  .footer__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid transparent; color: var(--fg-muted); transition: background .2s var(--ease), border-color .2s var(--ease), transform .2s var(--ease); }
  .footer__icon:hover { background: var(--bg-raised); border-color: var(--line-strong); transform: translateY(-1px); }
  /* Phones: icons first, copyright under them, both left-aligned. */
  @media (max-width: 540px) {
    .footer__in { flex-direction: column-reverse; align-items: flex-start; gap: var(--space-3); padding-block: var(--space-6) var(--space-8); }
    .footer__links { margin-left: -9px; }
  }
</style>

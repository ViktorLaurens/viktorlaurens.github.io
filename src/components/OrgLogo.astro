---
/**
 * An organisation's mark, without a background. Marks are shown at a common height so
 * square and wide logos line up. Logos whose dark parts would vanish on the dark theme
 * pass a `dark` variant (the organisation's reversed, white-on-dark version), which is
 * swapped in by the theme.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  href?: string;
  wide?: boolean;
}
const { src, dark, alt, href, wide = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['org', { 'org--wide': wide }]} href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener' : undefined} title={alt}>
  <Image class:list={['org__img', { 'org__img--light': !!dark }]} src={src} alt={alt} width={wide ? 260 : 96} densities={[1, 2]} loading="lazy" />
  {dark && <Image class="org__img org__img--dark" src={dark} alt="" width={wide ? 260 : 96} densities={[1, 2]} loading="lazy" />}
</Tag>

<style>
  .org { --h: 2.5rem; display: inline-flex; align-items: center; height: var(--h); transition: transform .2s var(--ease), filter .2s var(--ease); }
  a.org:hover { transform: translateY(-1px); filter: drop-shadow(0 4px 10px rgba(0,0,0,.25)); }
  .org__img { display: block; height: var(--h); width: auto; max-width: var(--h); object-fit: contain; }
  .org--wide .org__img { max-width: 6.5rem; height: auto; max-height: var(--h); }
  .org__img--dark { display: none; }
  :global([data-theme="dark"]) .org__img--light { display: none; }
  :global([data-theme="dark"]) .org__img--dark { display: block; }
  @media (max-width: 540px) { .org { --h: 2.1rem; } .org--wide .org__img { max-width: 5.25rem; } }
</style>

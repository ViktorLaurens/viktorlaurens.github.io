---
/** Live pendulum + phase portrait. Physics in src/sim/pendulum.ts. */
---
<div class="sim" id="pendulum-sim">
  <canvas class="sim__canvas" id="pendulum-canvas" aria-label="Interactive pendulum simulation with its phase portrait. Drag the bob to set it swinging; press Balance to let a controller swing it up and hold it upright." role="img"></canvas>
  <div class="sim__bar">
    <div class="sim__controls">
      <button class="btn btn--sm" id="sim-balance" type="button" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 20V6"/><circle cx="12" cy="4.5" r="2" fill="currentColor" stroke="none"/><path d="M6 20h12"/></svg>
        Balance
      </button>
      <button class="btn btn--sm" id="sim-reset" type="button">Reset</button>
    </div>
    <dl class="sim__readout mono" aria-live="off">
      <div><dt id="ro-theta-label">θ</dt><dd id="ro-theta">0.00</dd></div>
      <div><dt id="ro-omega-label">θ̇</dt><dd id="ro-omega">0.00</dd></div>
      <div><dt>u</dt><dd id="ro-u">0.00</dd></div>
      <div><dt>E/E<sub>top</sub></dt><dd id="ro-e">0.00</dd></div>
    </dl>
  </div>
  <p class="sim__toast mono" id="sim-toast" role="status" hidden></p>
  <p class="sim__caption muted">
    Live demo: a damped pendulum, θ̈ = −ω₀² sin θ − μ θ̇ + u, integrated with RK4 at 240 Hz. Drag the bob and let go, then press Balance: the controller pumps energy until it can reach the top, and a linear state feedback holds it there.
  </p>
</div>

<script>
  import { mountPendulum, type PendulumHandle } from '../sim/pendulum';

  let sim: PendulumHandle | null = null;

  function init() {
    const canvas = document.getElementById('pendulum-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const balance = document.getElementById('sim-balance') as HTMLButtonElement;
    const reset = document.getElementById('sim-reset') as HTMLButtonElement;
    const roT = document.getElementById('ro-theta')!;
    const roW = document.getElementById('ro-omega')!;
    const roTL = document.getElementById('ro-theta-label')!;
    const roWL = document.getElementById('ro-omega-label')!;
    const roU = document.getElementById('ro-u')!;
    const roE = document.getElementById('ro-e')!;
    const toast = document.getElementById('sim-toast') as HTMLParagraphElement;
    const fmt = (x: number) => (x >= 0 ? '+' : '−') + Math.abs(x).toFixed(2);

    const handle = mountPendulum({
      canvas,
      onState: (s) => {
        if (s.chaos) {
          roTL.textContent = 'θ₁'; roWL.textContent = 'θ₂';
          roT.textContent = fmt(s.theta);
          roW.textContent = fmt(s.theta2);
        } else {
          roTL.textContent = 'θ'; roWL.textContent = 'θ̇';
          roT.textContent = fmt(s.theta);
          roW.textContent = fmt(s.omega);
        }
        roU.textContent = fmt(s.u);
        roE.textContent = (s.energy / (2 * 9.81)).toFixed(2);
        balance.setAttribute('aria-pressed', String(s.control));
        balance.disabled = s.chaos;
      },
    });
    sim = handle;

    let toastTimer = 0;
    const say = (msg: string, ms = 4500) => {
      toast.textContent = msg; toast.hidden = false;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toast.hidden = true; }, ms);
    };
    const setChaos = (on: boolean) => {
      handle.setChaos(on);
      canvas.classList.toggle('is-chaos', on);
      if (on) say('↑↑↓↓←→←→BA · chaos mode: a double pendulum. Three deterministic equations, zero predictability. Esc to leave.', 7000);
      else say('Back to one pendulum.', 2000);
    };

    balance.addEventListener('click', () => {
      const on = !handle.getControl();
      handle.setControl(on);
      balance.setAttribute('aria-pressed', String(on));
    });
    reset.addEventListener('click', () => {
      handle.reset();
      canvas.classList.remove('is-chaos');
      balance.setAttribute('aria-pressed', 'false');
    });

    // Konami code → chaos mode; Esc leaves it.
    const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let pos = 0;
    keyHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && handle.getChaos()) { setChaos(false); return; }
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      pos = k === code[pos] ? pos + 1 : k === code[0] ? 1 : 0;
      if (pos === code.length) { pos = 0; setChaos(!handle.getChaos()); }
    };
    document.addEventListener('keydown', keyHandler);
    // touch devices: five quick taps on the pivot area of the readout label
    let taps = 0, lastTap = 0;
    roTL.parentElement?.addEventListener('click', () => {
      const now = performance.now();
      taps = now - lastTap < 600 ? taps + 1 : 1; lastTap = now;
      if (taps >= 5) { taps = 0; setChaos(!handle.getChaos()); }
    });
  }

  let keyHandler: ((e: KeyboardEvent) => void) | null = null;

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    sim?.destroy();
    sim = null;
    if (keyHandler) document.removeEventListener('keydown', keyHandler);
    keyHandler = null;
  });
</script>

<style>
  .sim { display: grid; gap: var(--space-3); }
  .sim__canvas { width: 100%; border-radius: var(--radius-lg); background: var(--bg-sunken); border: 1px solid var(--line); }
  .sim__bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); }
  .sim__controls { display: flex; gap: var(--space-2); }
  .sim__readout { display: flex; gap: var(--space-4); margin: 0; font-size: .82rem; color: var(--fg-muted); }
  .sim__readout div { display: flex; gap: .45em; }
  .sim__readout dt { color: var(--fg-faint); }
  .sim__readout dd { margin: 0; min-width: 4.2ch; font-variant-numeric: tabular-nums; color: var(--fg); }
  .sim__caption { font-size: .85rem; line-height: 1.5; font-family: var(--font-mono); }
  .sim__toast { font-size: .8rem; color: var(--yellow); border: 1px solid color-mix(in srgb, var(--yellow) 40%, transparent); background: color-mix(in srgb, var(--yellow) 8%, transparent); border-radius: var(--radius); padding: .5em .8em; }
  .sim__canvas.is-chaos { border-color: color-mix(in srgb, var(--red) 55%, var(--line)); }
  .btn:disabled { opacity: .45; cursor: not-allowed; }
  @media (max-width: 480px) { .sim__readout { gap: var(--space-3); font-size: .78rem; } }
</style>

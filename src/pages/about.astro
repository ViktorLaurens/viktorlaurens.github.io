---
import Base from '../layouts/Base.astro';

const experience = [
  {
    when: 'Mar 2025 – Jul 2026',
    what: 'Research engineer (ORMIT Talent trainee)',
    where: 'Buildwise, Belgian Construction Research Institute · Brussels',
    note: 'Learning-based visual perception and 3D reconstruction for building assessment and construction monitoring. Fine-tuned vision models in PyTorch for semantic and instance segmentation. Built reconstruction pipelines that pair EKF-based visual-inertial SLAM for online state estimation with offline bundle adjustment and factor-graph optimisation in GTSAM and Ceres, giving real-time scan-coverage feedback and more accurate models. Turned these into tools for condition assessment, renovation planning and progress monitoring against BIM.',
  },
  {
    when: 'Jul – Oct 2023',
    what: 'Research intern, Department of Engineering Cybernetics',
    where: 'NTNU · Trondheim, Norway',
    note: 'Distributed, communication-aware path planning for autonomous underwater fleets. Built an optical communication framework for AUVs with Hydromea Luma modems.',
  },
  {
    when: 'Sep – Dec 2022',
    what: 'Driverless team member',
    where: 'VUB Racing, Formula Student',
    note: 'The team\'s first driverless vehicle.',
  },
];

const education = [
  {
    when: '2022 – 2024',
    what: 'MSc Electromechanical Engineering: Robotics',
    where: 'Vrije Universiteit Brussel & Université Libre de Bruxelles',
    note: 'Magna cum laude. Control-oriented electives: Advanced Control (19/20), Optimisation-based Control Design (17/20). Projects on load-swing suppression for a knuckle crane, a PINN for pendulum prediction and parameter identification, vibration-isolation modelling for the Einstein Telescope, a self-written finite-element solver, real-time embedded systems and MPC for mobile robots. Thesis: a hybrid of Conflict-Based Search and Probabilistic Roadmaps for motion planning of multiple manipulators.',
  },
  {
    when: '2019 – 2022',
    what: 'BSc Engineering: Electromechanical Engineering',
    where: 'Vrije Universiteit Brussel',
    note: 'Magna cum laude. Student delegate. Co-wrote a course text on DC motor drives for ArcelorMittal Belgium. Most memorable project: a rope-climbing robot.',
  },
  {
    when: 'Nov 2024 – Apr 2025',
    what: 'Professional courses in machine learning',
    where: 'MIT Professional Education · Berkeley Haas',
    note: 'Applied Data Science Program (MIT) and Artificial Intelligence: Business Strategies and Applications (Berkeley): computer vision, NLP and decision-making.',
  },
];

const tools = [
  { k: 'Control & estimation', v: 'MATLAB / Simulink, Control System Toolbox, MPT3, CasADi, GTSAM, Ceres Solver' },
  { k: 'Learning', v: 'PyTorch, NumPy / SciPy, OpenCV' },
  { k: 'Robotics & simulation', v: 'ROS 2, MoveIt 2, PyBullet, MuJoCo, Robotics Toolbox, Isaac Sim / Isaac Lab' },
  { k: '3D reconstruction', v: 'COLMAP, 3D Gaussian Splatting, Metashape, Unity' },
  { k: 'Languages & tools', v: 'Python, C++, Java, Linux, Git, Autodesk Inventor' },
];
---
<Base title="About" description="Who I am: an engineer in control, learning and robotics from Brussels, with a weakness for nonlinear dynamics.">
  <section class="section container about">
    <div class="about__intro">
      <p class="eyebrow eyebrow--accent">About</p>
      <h1>Viktor Laurens De Groote</h1>
      <div class="prose" style="margin-top: var(--space-6)">
        <p class="lede">
          I'm an engineer in control, learning and robotics from Brussels, trained in electromechanical
          engineering at VUB and ULB.
        </p>
        <p>
          It started at sixteen, with a maths project on chaos theory and the Lorenz attractor: three
          deterministic equations producing behaviour nobody could predict. Years later I came across control
          theory, which turns the question around. Not <em>what will this system do</em>,
          but <em>what can we make it do, and under which conditions can we guarantee it</em>. That
          question still drives most of what I work on.
        </p>
        <p>
          Most recently I spent a year and a half at Buildwise, Belgium's research institute for
          construction, on learning-based perception and 3D reconstruction: visual-inertial SLAM for
          online state estimation, factor-graph optimisation for offline accuracy, and fine-tuned
          vision models, all shipped as tools people use on building sites. Before that: optical
          communication for autonomous underwater vehicles at NTNU, and a thesis on multi-robot motion
          planning.
        </p>
        <p>
          I'm drawn to research because it asks us to question what we think we know and to turn
          understanding into working technology.
        </p>
      </div>
      <div class="about__cta">
        <a class="btn btn--primary" href="/cv.pdf" download="Viktor_Laurens_De_Groote_CV.pdf">Download CV (PDF)</a>
        <a class="btn" href="mailto:viktor.degroote@gmail.com">Email</a>
        <a class="btn" href="https://www.linkedin.com/in/viktor-laurens-de-groote/" target="_blank" rel="noopener">LinkedIn</a>
      </div>

      <h2 class="h3" style="margin-top: var(--space-16)">Toolbox</h2>
      <dl class="tools">
        {tools.map((t) => (
          <div class="tools__row">
            <dt>{t.k}</dt>
            <dd class="mono">{t.v}</dd>
          </div>
        ))}
      </dl>
      <p class="mono tools__langs muted">Dutch (native) · English (C1) · French (B2) · German (B1) · Norwegian (A1)</p>
    </div>

    <div class="about__side">
      <h2 class="h3">Experience</h2>
      <ol class="timeline">
        {experience.map((t) => (
          <li>
            <span class="mono timeline__when">{t.when}</span>
            <div>
              <p class="timeline__what">{t.what}</p>
              <p class="muted timeline__where">{t.where}</p>
              <p class="timeline__note">{t.note}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="h3">Education</h2>
      <ol class="timeline">
        {education.map((t) => (
          <li>
            <span class="mono timeline__when">{t.when}</span>
            <div>
              <p class="timeline__what">{t.what}</p>
              <p class="muted timeline__where">{t.where}</p>
              <p class="timeline__note">{t.note}</p>
            </div>
          </li>
        ))}
      </ol>

      <h2 class="h3">Off the clock</h2>
      <p class="muted">Tennis, padel, golf, cycling and running. Chess, cooking, travel, and engineering projects that have no business being finished on a weekend.</p>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; gap: var(--space-16); }
  @media (min-width: 980px) { .about { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-24); } }
  .about__cta { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-8); }
  .h3 { font-size: 1.1rem; margin-top: var(--space-12); margin-bottom: var(--space-4); }
  .about__side > .h3:first-child { margin-top: 0; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-6); }
  .timeline li { display: grid; gap: var(--space-2); grid-template-columns: 1fr; padding-top: var(--space-4); border-top: 1px solid var(--line); }
  @media (min-width: 540px) { .timeline li { grid-template-columns: 9.5rem 1fr; gap: var(--space-4); } }
  .timeline__when { font-size: .82rem; color: var(--fg-muted); padding-top: .25em; }
  .timeline__what { font-weight: 600; }
  .timeline__where { font-size: .95rem; }
  .timeline__note { margin-top: .4em; font-size: .95rem; color: var(--fg-muted); line-height: 1.5; }
  .tools { margin: 0; display: grid; gap: var(--space-3); }
  .tools__row { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 1px solid var(--line); }
  @media (min-width: 540px) { .tools__row { grid-template-columns: 11rem 1fr; gap: var(--space-4); } }
  .tools dt { font-weight: 500; font-size: .95rem; }
  .tools dd { margin: 0; font-size: .85rem; color: var(--fg-muted); line-height: 1.7; }
  .tools__langs { font-size: .85rem; margin-top: var(--space-6); }
</style>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LoopVideo from '../../components/LoopVideo.astro';
import { publishedChapters } from '../../lib/chapters';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const { title, summary, date, tags, repo, heroVideo, heroPoster, heroAlt, status, outline, outlineNote } = project.data;
const soon = status === 'soon';
const toc = headings.filter((h) => h.depth === 2);
const chapters = (await publishedChapters(project.id))
  .sort((a, b) => a.data.number - b.data.number);
const chapterSlug = (id: string) => id.split('/').pop();
---
<Base title={title} description={summary}>
  <article class="project container">
    {heroVideo && heroPoster ? (
      <LoopVideo class="project__hero" src={heroVideo} poster={heroPoster} alt={heroAlt ?? title} />
    ) : heroPoster ? (
      <img class="project__hero project__still" src={heroPoster} alt={heroAlt ?? title} width="960" height="540" />
    ) : null}
    <header class="project__head">
      <p class="eyebrow eyebrow--accent">Project · {date.getFullYear()}{soon && ' · in progress'}</p>
      <h1>{title} {soon && <span class="soon project__soon">Coming soon</span>}</h1>
      <p class="lede">{summary}</p>
      <div class="project__meta">
        {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
        {repo && <a class="btn btn--sm" href={repo} target="_blank" rel="noopener">View code →</a>}
      </div>
    </header>

    {soon && (
      <aside class="notice" role="note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v5l3 2" /><circle cx="12" cy="12" r="9" /></svg>
        <p>
          <strong>Under construction.</strong> The chapters are being written and checked. This page is the
          overview; the full report, with its figures and animations, will appear here soon.
        </p>
      </aside>
    )}

    {chapters.length > 0 && (
      <section class="chapters" aria-labelledby="chapters-title">
        <div class="section__head">
          <h2 id="chapters-title">Chapters</h2>
          <p class="eyebrow">{chapters.length} parts</p>
        </div>
        <ol class="chapters__list">
          {chapters.map((c) => (
            <li>
              <a class="chapter" href={`/projects/${project.id}/${chapterSlug(c.id)}/`}>
                <span class="chapter__num mono">{String(c.data.number).padStart(2, '0')}</span>
                <span class="chapter__body">
                  <span class="chapter__title">{c.data.title}</span>
                  <span class="chapter__summary">{c.data.summary}</span>
                </span>
                <span class="chapter__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <div class="project__body">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>

    {soon && outline.length > 0 && (
      <section class="chapters outline" aria-labelledby="outline-title">
        <div class="section__head">
          <h2 id="outline-title">What is coming</h2>
          <p class="eyebrow">{outline.length} chapters</p>
        </div>
        <ol class="chapters__list">
          {outline.map((c, i) => (
            <li>
              <div class="chapter chapter--planned">
                <span class="chapter__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="chapter__body">
                  <span class="chapter__title">{c.title}</span>
                  <span class="chapter__summary">{c.summary}</span>
                </span>
              </div>
            </li>
          ))}
        </ol>
        {outlineNote && <p class="muted outline__note">{outlineNote}</p>}
      </section>
    )}
  </article>
</Base>

<style>
  .project { padding-block: var(--space-12); }
  .project :global(.project__hero) { margin-bottom: var(--space-10, 2.5rem); max-width: 60rem; }
  .project__head { display: grid; gap: var(--space-4); max-width: 60rem; margin-bottom: var(--space-12); }
  .project__meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-2); }
  .chapters { margin-bottom: var(--space-16); }
  .chapters__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .chapter { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: var(--space-4); align-items: center; padding: var(--space-4) var(--space-5, 1.25rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-raised); text-decoration: none; color: inherit; transition: border-color .2s var(--ease), transform .2s var(--ease); }
  a.chapter:hover { border-color: var(--accent); transform: translateX(3px); color: inherit; }
  a.chapter:hover .chapter__title, a.chapter:hover .chapter__arrow { color: var(--accent); }
  .chapter__num { font-size: 1.4rem; color: var(--fg-faint); }
  .chapter__body { display: grid; gap: .15em; }
  .chapter__title { font-weight: 600; font-size: 1.05rem; }
  .chapter__summary { color: var(--fg-muted); font-size: .92rem; line-height: 1.45; }
  .chapter__arrow { color: var(--fg-faint); font-size: 1.2rem; }
  .chapter--planned { border-style: dashed; border-color: var(--line-strong); background: transparent; }
  .chapter--planned .chapter__num { color: var(--fg-faint); }
  .project__still { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius-lg); border: 1px solid var(--line); }
  .project__soon { font-size: .8rem; vertical-align: middle; margin-left: .4em; position: relative; top: -.2em; }
  .notice { display: flex; gap: var(--space-4); align-items: flex-start; max-width: 60rem; margin: calc(-1 * var(--space-6)) 0 var(--space-12); padding: var(--space-4) var(--space-6); border: 1px solid color-mix(in srgb, var(--soon) 45%, transparent); background: color-mix(in srgb, var(--soon) 8%, transparent); border-radius: var(--radius-lg); }
  .notice svg { flex-shrink: 0; width: 22px; height: 22px; margin-top: .15em; fill: none; stroke: var(--soon); stroke-width: 1.8; stroke-linecap: round; }
  .notice p { margin: 0; color: var(--fg-muted); }
  .notice strong { color: var(--fg); }
  .outline__note { margin-top: var(--space-4); font-size: .92rem; }
  .outline { margin: var(--space-16) 0 0; }
  .project__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .project__body > * { min-width: 0; }
  @media (min-width: 1024px) { .project__body { grid-template-columns: 220px minmax(0, 1fr); } }
  .toc { position: sticky; top: 88px; font-size: .9rem; }
  .toc ol { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: .4em; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: .15em 0 .15em .9em; color: var(--fg-muted); text-decoration: none; border-left: 1.5px solid transparent; margin-left: -1px; }
  .toc a:hover, .toc a[aria-current="location"] { color: var(--fg); border-left-color: var(--accent); }
  @media (max-width: 1023px) { .toc { position: static; } }
  @media (max-width: 540px) { .chapter { grid-template-columns: 2.2rem minmax(0, 1fr); } .chapter__arrow { display: none; } .chapter__num { font-size: 1.1rem; } }
</style>
